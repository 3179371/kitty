# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Sandbox Business account that plays the gift shop (receives the purchase payout)
GIFT_SHOP_EMAIL=
GIFT_SHOP_NAME=Kitty Demo Gift Shop

# Optional: sandbox Personal account that receives the invoices, so you can pay them in the sandbox
SANDBOX_BUYER_EMAIL=

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: Channel3 product search (https://trychannel3.com). Without it Kitty uses a small demo catalog.
CHANNEL3_API_KEY=

# Where demo data is kept (ephemeral is fine)
KITTY_DATA_FILE=/tmp/kitty-data.json
